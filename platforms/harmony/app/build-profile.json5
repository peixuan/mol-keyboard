{
  "app": {
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "bundleName": "cn.zhangpeixuan.molkeyboard",
        "signingConfig": "default",
        "targetSdkVersion": "5.0.0(12)",
        "compatibleSdkVersion": "5.0.0(12)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      },
      {
        "name": "openharmony",
        "bundleName": "cn.zhangpeixuan.molkeyboard",
        "signingConfig": "default",
        "compileSdkVersion": 12,
        "targetSdkVersion": 12,
        "compatibleSdkVersion": 12,
        "runtimeOS": "OpenHarmony",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    },
    {
      "name": "entryOpenHarmony",
      "srcPath": "./entry-openharmony",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "openharmony"
          ]
        }
      ]
    }
  ]
}
