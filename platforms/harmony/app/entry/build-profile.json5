{
  "apiType": "stageMode",
  "buildOption": {
    "externalNativeOptions": {
      "path": "./src/main/cpp/CMakeLists.txt",
      "arguments": "-DMOL_HARMONY_BUNDLE_NAME=cn.zhangpeixuan.molkeyboard",
      "cppFlags": "-std=c++17 -fno-exceptions -fno-rtti",
      "abiFilters": [
        "arm64-v8a",
        "x86_64"
      ]
    }
  },
  "targets": [
    {
      "name": "default"
    }
  ]
}
